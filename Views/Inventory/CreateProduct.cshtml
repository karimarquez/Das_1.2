@model ProductInputViewModel
@{
    ViewData["Title"] = "Nuevo producto";
}

<section class="page-heading">
    <div><p class="eyebrow">CATÁLOGO DE BAR</p><h1>Nuevo producto</h1><p class="muted">Define presentación, unidad de control y nivel mínimo.</p></div>
    <a class="button button-secondary" asp-action="Index">Volver al inventario</a>
</section>

<section class="panel form-panel">
    <form asp-action="CreateProduct" method="post" class="product-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label class="form-label">Nombre del producto<input asp-for="Name" class="form-control" placeholder="Ej. Soda de limón" /><span asp-validation-for="Name" class="validation-message"></span></label>
        <label class="form-label">Categoría<select asp-for="Category" class="form-select"><option>Cervezas y sodas</option><option>Licores</option><option>Zumos y jugos</option><option>Lácteos</option><option>Frutas e insumos</option><option>Desechables</option></select></label>
        <label class="form-label">Presentación<input asp-for="Presentation" class="form-control" placeholder="Ej. Botella 600 ml" /><span asp-validation-for="Presentation" class="validation-message"></span></label>
        <label class="form-label">Unidad de control<input asp-for="Unit" class="form-control" placeholder="Ej. botellas" /><span asp-validation-for="Unit" class="validation-message"></span></label>
        <label class="form-label">Unidad base de receta<input asp-for="BaseUnit" class="form-control" placeholder="Ej. oz" /><span asp-validation-for="BaseUnit" class="validation-message"></span></label>
        <label class="form-label">Unidades base por presentación<input asp-for="BaseUnitsPerStockUnit" class="form-control" type="number" min="0.0001" step="0.0001" /><span asp-validation-for="BaseUnitsPerStockUnit" class="validation-message"></span><span class="form-hint">Ejemplo: 25.36 oz por botella de 750 ml.</span></label>
        <label class="form-label">Existencia inicial<input asp-for="Stock" class="form-control" type="number" min="0" step="0.01" /><span asp-validation-for="Stock" class="validation-message"></span></label>
        <label class="form-label">Stock mínimo<input asp-for="MinimumStock" class="form-control" type="number" min="0" step="0.01" /><span asp-validation-for="MinimumStock" class="validation-message"></span></label>
        <label class="form-label">Costo unitario ($)<input asp-for="UnitCost" class="form-control" type="number" min="0" step="0.01" /><span asp-validation-for="UnitCost" class="validation-message"></span></label>
        <div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancelar</a><button class="button button-primary" type="submit">Guardar producto</button></div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
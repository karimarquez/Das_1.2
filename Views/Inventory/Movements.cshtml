@model IReadOnlyList<InventoryMovement>
@{
    ViewData["Title"] = "Movimientos";
}

<section class="page-heading">
    <div><p class="eyebrow">TRAZABILIDAD</p><h1>Movimientos</h1><p class="muted">Entradas, consumos, mermas y ajustes de inventario.</p></div>
    <a class="button button-primary" asp-action="Index">Volver al inventario</a>
</section>

<section class="panel full-panel">
    <div class="panel-heading"><div><p class="eyebrow">BITÁCORA</p><h2>@Model.Count registros</h2></div></div>
    <div class="table-scroll"><table class="inventory-table movement-table"><thead><tr><th>Fecha y hora</th><th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Motivo</th><th>Usuario</th></tr></thead><tbody>
    @foreach (var movement in Model)
    {
        var typeClass = movement.Type == "Entrada" ? "status-ok" : movement.Type == "Merma" ? "status-low" : "status-neutral";
        <tr><td>@movement.RecordedAt.ToString("dd/MM/yyyy HH:mm")</td><td><span class="product-name">@movement.ProductName</span></td><td><span class="status-pill @typeClass">@movement.Type</span></td><td>@movement.Quantity.ToString("0.##") @movement.Unit</td><td>@movement.Reason</td><td>@movement.UserName</td></tr>
    }
    </tbody></table></div>
</section>
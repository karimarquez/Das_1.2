@model ReportsViewModel
@{
    ViewData["Title"] = Model.IsDaily ? "Reporte diario" : "Reporte mensual";
    var dateValue = Model.ReferenceDate.ToString("yyyy-MM-dd");
}

<section class="page-heading">
    <div><p class="eyebrow">ANÁLISIS DE BAR</p><h1>Reporte @(Model.IsDaily ? "diario" : "mensual")</h1><p class="muted">Actividad registrada durante @Model.PeriodLabel.</p></div>
    <div class="heading-actions"><a class="button @(Model.IsDaily ? "button-secondary" : "button-primary")" asp-action="Index" asp-route-period="diario" asp-route-fecha="@dateValue">Diario</a><a class="button @(!Model.IsDaily ? "button-secondary" : "button-primary")" asp-action="Index" asp-route-period="mensual" asp-route-fecha="@dateValue">Mensual</a></div>
    <div class="heading-actions"><a class="button button-secondary" asp-action="Export" asp-route-period="@Model.PeriodRouteValue" asp-route-fecha="@dateValue">Exportar CSV</a><a class="button button-secondary" asp-controller="Inventory" asp-action="Index">Volver al inventario</a></div>
</section>

@if (ViewData["DateError"] is string dateError)
{
    <div class="notice notice-error" role="alert">@dateError</div>
}

<form asp-action="Index" asp-route-period="@Model.PeriodRouteValue" method="get" class="d-flex flex-wrap align-items-end gap-2 mb-3">
    <label class="form-label mb-0">Fecha de referencia<input class="form-control" type="date" name="fecha" value="@dateValue" max="@DateTime.Today.ToString("yyyy-MM-dd")" /></label>
    <button class="button button-secondary" type="submit">Ver período</button>
</form>

<section class="metric-grid report-metrics">
    <article class="metric-card"><span class="metric-label">Entradas</span><strong class="metric-value">@Model.EntryCount.ToString("00")</strong><span class="metric-note">Registros del período</span></article>
    <article class="metric-card"><span class="metric-label">Consumos</span><strong class="metric-value">@Model.ConsumptionCount.ToString("00")</strong><span class="metric-note">$@Model.ConsumptionCost.ToString("0.00") en costo de insumos</span></article>
    <article class="metric-card metric-warning"><span class="metric-label">Mermas</span><strong class="metric-value">@Model.WasteCount.ToString("00")</strong><span class="metric-note">$@Model.WasteCost.ToString("0.00") en pérdidas</span></article>
    <article class="metric-card metric-accent"><span class="metric-label">Productos consumidos</span><strong class="metric-value">@Model.ProductsConsumedCount.ToString("00")</strong><span class="metric-note">Productos distintos en el período</span></article>
</section>

<section class="panel full-panel mb-3">
    <div class="panel-heading"><div><p class="eyebrow">RESUMEN POR PRODUCTO</p><h2>Consumo, mermas y existencias</h2></div></div>
    <div class="table-scroll"><table class="inventory-table movement-table"><thead><tr><th>Producto</th><th>Entradas</th><th>Consumo</th><th>Mermas</th><th>Ajustes</th><th>Existencia actual</th><th>Costo de mermas</th></tr></thead><tbody>
    @foreach (var line in Model.Lines)
    {
        <tr><td><a class="product-name" asp-controller="Products" asp-action="Details" asp-route-id="@line.ProductId">@line.ProductName</a><span class="product-detail">@line.Category · @line.Unit</span></td><td>@line.Entries.ToString("0.##")</td><td>@line.Consumption.ToString("0.##")</td><td>@line.Waste.ToString("0.##")</td><td>@(line.Adjustments > 0 ? "+" : "")@line.Adjustments.ToString("0.##")</td><td><span class="status-pill @(line.IsLowStock ? "status-low" : "status-ok")">@line.CurrentStock.ToString("0.##") @line.Unit</span></td><td>$@line.WasteCost.ToString("0.00")</td></tr>
    }
    </tbody></table></div>
</section>

<section class="panel full-panel">
    <div class="panel-heading"><div><p class="eyebrow">DETALLE DEL PERÍODO</p><h2>@(Model.IsDaily ? "Movimientos del día" : "Últimos movimientos del mes")</h2></div></div>
    <div class="table-scroll"><table class="inventory-table movement-table"><thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Motivo</th></tr></thead><tbody>
    @foreach (var movement in Model.Movements.Take(12))
    {
        <tr><td>@movement.RecordedAt.ToString("dd/MM HH:mm")</td><td><span class="product-name">@movement.ProductName</span></td><td>@movement.Type</td><td>@(movement.IsIncrease ? "+" : "−")@movement.Quantity.ToString("0.##") @movement.Unit</td><td>@movement.Reason</td></tr>
    }
    </tbody></table></div>
    @if (Model.Movements.Count == 0)
    {
        <p class="empty-state">No hay movimientos registrados en este período.</p>
    }
</section>

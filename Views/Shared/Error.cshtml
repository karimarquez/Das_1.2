@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="page-heading">
    <div><p class="eyebrow">ERROR</p><h1>Ocurrió un error inesperado</h1><p class="muted">No fue posible procesar la solicitud. Inténtalo de nuevo y, si el problema continúa, avisa al administrador.</p></div>
</section>

<section class="panel form-panel">
    @if (Model.ShowRequestId)
    {
        <p class="muted mb-3"><strong>Código de la solicitud:</strong> <code>@Model.RequestId</code></p>
    }
    <a class="button button-primary" asp-controller="Inventory" asp-action="Index">Volver al inventario</a>
</section>

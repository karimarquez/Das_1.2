@model RecipesViewModel
@{
    ViewData["Title"] = "Recetas";
}

<section class="page-heading">
    <div><p class="eyebrow">PREPARACIÓN DE BEBIDAS</p><h1>Recetas</h1><p class="muted">Registra porciones preparadas y descuenta sus ingredientes.</p></div>
    <div class="heading-actions">
        <a class="button button-secondary" asp-controller="Inventory" asp-action="Index">Volver al inventario</a>
        <a class="button button-primary" asp-action="Create">+ Nueva receta</a>
    </div>
</section>

@if (TempData["Success"] is string success) { <div class="notice notice-success" role="status">@success</div> }
@if (TempData["Error"] is string error) { <div class="notice notice-error" role="alert">@error</div> }

<section class="recipe-grid">
@foreach (var recipe in Model.Recipes)
{
    <article class="panel recipe-card">
        <div class="recipe-heading"><div><p class="eyebrow">RECETA · @recipe.Id.ToString("00")</p><h2>@recipe.Name</h2></div><span class="recipe-stamp">BAR</span></div>
        <p class="muted recipe-description">@recipe.Description</p>
        <div class="recipe-ingredients"><span class="recipe-label">INGREDIENTES POR PORCIÓN</span>
            @foreach (var ingredient in recipe.Ingredients)
            {
                <div class="recipe-line"><span>@ingredient.ProductName</span><strong>@ingredient.QuantityPerServing.ToString("0.###") @ingredient.BaseUnit</strong></div>
            }
        </div>
        <form asp-action="Prepare" asp-route-recipeId="@recipe.Id" method="post" class="recipe-action">
            <label class="form-label">Porciones<input class="form-control" type="number" name="Servings" min="1" max="1000" value="1" required /></label>
            <button class="button button-primary" type="submit">Registrar preparación</button>
        </form>
    </article>
}
</section>
@if (Model.Recipes.Count == 0)
{
    <p class="empty-state">Todavía no hay recetas registradas.</p>
}

<p class="recipe-footnote">Las cantidades de receta se convierten a la presentación de inventario usando la equivalencia configurada en cada producto.</p>
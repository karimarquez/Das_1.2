@model RecipeFormViewModel
@{
    ViewData["Title"] = "Nueva receta";
}

<section class="page-heading">
    <div><p class="eyebrow">PREPARACIÓN DE BEBIDAS</p><h1>Nueva receta</h1><p class="muted">Indica los ingredientes de una porción en la unidad base de cada producto.</p></div>
    <a class="button button-secondary" asp-action="Index">Volver a recetas</a>
</section>

<section class="panel form-panel">
    <form asp-action="Create" method="post" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="product-form">
            <label class="form-label">@Html.DisplayNameFor(m => m.Name)<input asp-for="Name" class="form-control" placeholder="Ej. Refresco de tamarindo" /><span asp-validation-for="Name" class="validation-message"></span></label>
            <label class="form-label">@Html.DisplayNameFor(m => m.Description)<input asp-for="Description" class="form-control" placeholder="Ej. Refresco natural servido con hielo" /><span asp-validation-for="Description" class="validation-message"></span></label>
        </div>
        <div class="recipe-ingredients">
            <span class="recipe-label">INGREDIENTES POR PORCIÓN</span>
            @for (var i = 0; i < Model.Ingredients.Count; i++)
            {
                <div class="row g-2 align-items-start mb-1">
                    <div class="col-12 col-md-8">
                        <label class="form-label"><span class="visually-hidden">Producto del ingrediente @(i + 1)</span><select asp-for="Ingredients[i].ProductId" asp-items="Model.ProductOptions" class="form-select"><option value="">Selecciona un producto</option></select><span asp-validation-for="Ingredients[i].ProductId" class="validation-message"></span></label>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label"><span class="visually-hidden">Cantidad por porción del ingrediente @(i + 1)</span><input asp-for="Ingredients[i].QuantityPerServing" class="form-control" type="number" min="0.0001" step="0.0001" placeholder="Cantidad por porción" /><span asp-validation-for="Ingredients[i].QuantityPerServing" class="validation-message"></span></label>
                    </div>
                </div>
            }
            <p class="form-hint">Deja vacías las filas que no uses. La unidad entre paréntesis es la unidad base del producto (por ejemplo, oz para licores).</p>
        </div>
        <div class="form-actions"><a class="button button-secondary" asp-action="Index">Cancelar</a><button class="button button-primary" type="submit">Guardar receta</button></div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pipiris Nais System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/wwwroot/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark header-nav px-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" href="#">
                    <i class="fa-solid fa-wine-glass-empty text-emerald-300 me-2"></i>Pipiris Nais | Bar
                </a>
                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" href="#"><i class="fa-solid fa-boxes-stacked me-1"></i>Inventario</a>
                        </li>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="text-center text-muted py-3 mt-5 border-top">
        <small>&copy; 2026 Restaurante Pipiris Nais - Sistema de Gestión de Inventario.</small>
    </footer>
</body>
</html>
@using System.Globalization
@model InventoryDashboardViewModel
@{
    ViewData["Title"] = "Inventario";
    var categories = Model.Products.Select(product => product.Category).Distinct().OrderBy(category => category).ToList();
}

<div data-page="inventory" data-dashboard-url="@Url.Action("Get", "DashboardApi")" data-activity-url="@Url.Action("RecentActivity", "Inventory")">

<section class="page-heading">
    <div>
        <p class="eyebrow">PIPIRIS NAIS <span>·</span> CONTROL DE BAR</p>
        <h1>Inventario</h1>
        <p class="muted">Existencias y actividad del área de bebidas.</p>
    </div>
    <div class="heading-actions">
        @if (User.CanManageInventory())
        {
            <a class="button button-secondary" asp-controller="Products" asp-action="Create">+ Producto</a>
            <a class="button button-secondary" asp-action="Count">Conteo de cierre</a>
            <button class="button button-primary" type="button" data-bs-toggle="modal" data-bs-target="#movementModal">+ Registrar movimiento</button>
        }
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="notice notice-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="notice notice-error" role="alert">@error</div>
}

<section class="metric-grid" aria-label="Resumen de inventario">
    <article class="metric-card">
        <span class="metric-label">Productos activos</span>
        <strong class="metric-value" data-metric="productCount">@Model.ProductCount.ToString("00")</strong>
        <span class="metric-note">En el catálogo de bar</span>
    </article>
    <article class="metric-card metric-warning">
        <span class="metric-label">Bajo mínimo</span>
        <strong class="metric-value" data-metric="lowStockCount">@Model.LowStockCount.ToString("00")</strong>
        <span class="metric-note">Requieren revisión</span>
    </article>
    <article class="metric-card">
        <span class="metric-label">Movimientos de hoy</span>
        <strong class="metric-value" data-metric="todayMovementCount">@Model.TodayMovementCount.ToString("00")</strong>
        <span class="metric-note">Entradas, consumos y mermas</span>
    </article>
    <article class="metric-card metric-accent">
        <span class="metric-label">Consumos registrados hoy</span>
        <strong class="metric-value" data-metric="todayConsumptionCount">@Model.TodayConsumptionCount.ToString("00")</strong>
        <span class="metric-note">Operaciones registradas</span>
    </article>
</section>

<div class="workspace-grid">
    <section class="panel inventory-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">EXISTENCIAS</p>
                <h2>Productos del bar</h2>
            </div>
            <a class="text-link" asp-controller="Movements" asp-action="Index">Ver movimientos <span aria-hidden="true">→</span></a>
        </div>
        <div class="table-tools">
            <label class="search-field"><span class="visually-hidden">Buscar producto</span><input id="productSearch" type="search" placeholder="Buscar producto..." /></label>
            <label class="filter-select"><span class="visually-hidden">Filtrar por categoría</span>
                <select id="categoryFilter"><option value="">Todas las categorías</option>@foreach (var category in categories) { <option value="@category">@category</option> }</select>
            </label>
        </div>
        <div class="table-scroll">
            <table class="inventory-table">
                <thead><tr><th>Producto</th><th>Ubicación</th><th>Existencia</th><th>Estado</th><th><span class="visually-hidden">Acciones</span></th></tr></thead>
                <tbody>
                @foreach (var product in Model.Products)
                {
                    var isLow = product.Stock <= product.MinimumStock;
                    <tr data-product-id="@product.Id" data-product="@product.Name.ToLowerInvariant()" data-category="@product.Category">
                        <td><a class="product-name" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@product.Name</a><span class="product-detail">@product.Presentation · @product.Category</span></td>
                        <td class="location-cell">@product.Location</td>
                        <td><div class="stock-cell"><strong data-role="stock">@product.Stock.ToString("0.##")</strong><span>@product.Unit</span></div><div class="stock-track"><span class="@(isLow ? "stock-fill stock-fill-low" : "stock-fill") @StockLevel.CssClass(product.Stock, product.MinimumStock)" data-role="stock-fill"></span></div></td>
                        <td><span class="status-pill @(isLow ? "status-low" : "status-ok")" data-role="status">@(isLow ? "Reponer" : "Disponible")</span></td>
                        <td>
                            @if (User.CanManageInventory())
                            {
                                <button class="icon-button count-button" type="button" title="Registrar conteo físico" aria-label="Registrar conteo físico de @product.Name" data-product-id="@product.Id" data-product-name="@product.Name" data-current-stock="@product.Stock.ToString("0.##", CultureInfo.InvariantCulture)" data-unit="@product.Unit" data-bs-toggle="modal" data-bs-target="#countModal">···</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            <p id="emptySearch" class="empty-state" hidden>No hay productos que coincidan con la búsqueda.</p>
        </div>
        <div class="table-footnote">El mínimo está configurado por producto. El saldo cambia con cada movimiento validado.</div>
    </section>

    <aside class="panel activity-panel">
        <div class="panel-heading">
            <div><p class="eyebrow">REGISTRO RECIENTE</p><h2>Actividad</h2></div>
            <div class="panel-tools">
                <button class="icon-link refresh-button" type="button" data-action="refresh-dashboard" title="Actualizar tablero" aria-label="Actualizar el tablero sin recargar la página">↻</button>
                <a class="icon-link" asp-controller="Movements" asp-action="Index" aria-label="Abrir todos los movimientos">↗</a>
            </div>
        </div>
        <div id="recentActivity" aria-live="polite">
            <partial name="_RecentActivity" model="Model.RecentMovements" />
        </div>
        <p class="refresh-note" data-role="last-updated"></p>
        <a class="button button-quiet full-width" asp-controller="Reports" asp-action="Index">Consultar reporte mensual <span aria-hidden="true">→</span></a>
    </aside>
</div>

@if (User.CanManageInventory())
{
<div class="modal fade" id="movementModal" tabindex="-1" aria-labelledby="movementModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content app-modal">
        <form id="movementForm" asp-controller="Movements" asp-action="Register" method="post" data-async-url="@Url.Action("Register", "MovementsApi")">
            <div class="modal-header"><div><p class="eyebrow">ACTUALIZAR EXISTENCIAS</p><h2 class="modal-title" id="movementModalTitle">Registrar movimiento</h2></div><button type="button" class="close-button" data-bs-dismiss="modal" aria-label="Cerrar">×</button></div>
            <div class="modal-body form-stack">
                <div class="validation-summary" data-role="form-errors" role="alert"></div>
                <label class="form-label">Tipo de movimiento<select asp-for="Movement.Type" name="Type" id="movementType" class="form-select" asp-items="Model.MovementTypeOptions"></select><span class="validation-message" data-valmsg-for="Type" data-valmsg-replace="true"></span></label>
                <label class="form-label">Producto<select asp-for="Movement.ProductId" name="ProductId" id="movementProduct" class="form-select" asp-items="Model.ProductOptions"></select><span class="validation-message" data-valmsg-for="ProductId" data-valmsg-replace="true"></span></label>
                <label class="form-label">Cantidad<input asp-for="Movement.Quantity" name="Quantity" id="movementQuantity" class="form-control" type="number" min="0.01" step="0.01" value="" /><span class="validation-message" data-valmsg-for="Quantity" data-valmsg-replace="true"></span></label>
                <label class="form-label">Motivo<input asp-for="Movement.Reason" name="Reason" id="movementReason" class="form-control" placeholder="Ej. Reposición de proveedor" /><span class="validation-message" data-valmsg-for="Reason" data-valmsg-replace="true"></span></label>
                <label class="form-label">Fecha del movimiento<input asp-for="Movement.Date" name="Date" id="movementDate" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" /><span class="validation-message" data-valmsg-for="Date" data-valmsg-replace="true"></span></label>
                <p class="form-hint">Consumo y merma no pueden superar las existencias disponibles. Si no eliges fecha se registra con la fecha y hora actual.</p>
            </div>
            <div class="modal-footer"><button type="button" class="button button-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="button button-primary">Guardar movimiento</button></div>
        </form>
    </div></div>
</div>

<div class="modal fade" id="countModal" tabindex="-1" aria-labelledby="countModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content app-modal">
        <form id="countForm" asp-action="RegisterCount" method="post" data-async-url="@Url.Action("Register", "PhysicalCountsApi")">
            <div class="modal-header"><div><p class="eyebrow">CIERRE DE TURNO</p><h2 class="modal-title" id="countModalTitle">Conteo físico</h2></div><button type="button" class="close-button" data-bs-dismiss="modal" aria-label="Cerrar">×</button></div>
            <div class="modal-body form-stack">
                <div class="validation-summary" data-role="form-errors" role="alert"></div>
                <input id="countProductId" type="hidden" name="ProductId" />
                <p id="countProductLabel" class="count-product-label"></p>
                <p class="form-hint">Se comparará con el saldo teórico y se registrará cualquier diferencia.</p>
                <label class="form-label">Cantidad contada<input asp-for="Count.ActualStock" name="ActualStock" id="actualStock" class="form-control" type="number" min="0" step="0.01" value="" /><span class="validation-message" data-valmsg-for="ActualStock" data-valmsg-replace="true"></span></label>
            </div>
            <div class="modal-footer"><button type="button" class="button button-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="button button-primary">Comparar conteo</button></div>
        </form>
    </div></div>
</div>
}

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/inventory.js" asp-append-version="true"></script>
}

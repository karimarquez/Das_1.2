@model IReadOnlyList<MovementDto>
@if (Model.Count == 0)
{
    <p class="empty-state">Aún no hay movimientos registrados.</p>
}
else
{
    <ol class="activity-list">
    @foreach (var movement in Model)
    {
        var movementClass = movement.Type == MovementType.Entrada ? "activity-entry" : movement.Type == MovementType.Merma ? "activity-waste" : "activity-use";
        <li class="activity-item" data-movement-id="@movement.Id">
            <span class="activity-mark @movementClass" aria-hidden="true"></span>
            <div class="activity-copy"><strong>@movement.ProductName</strong><span>@movement.Type · @movement.Reason</span><time datetime="@movement.RecordedAt.ToString("s")">@movement.RecordedAt.ToString("HH:mm")</time></div>
            <span class="activity-quantity @(movement.IsIncrease ? "quantity-positive" : "")">@(movement.IsIncrease ? "+" : "−")@movement.Quantity.ToString("0.##")</span>
        </li>
    }
    </ol>
}
